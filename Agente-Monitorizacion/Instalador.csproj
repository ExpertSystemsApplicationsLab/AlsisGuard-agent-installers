<?xml version="1.0" encoding="utf-8"?>
<!--
  Proyecto de Visual Studio (opcional).
  Alternativa a build.ps1 para quien prefiera compilar desde Visual Studio.
  IMPORTANTE: antes de compilar aqui, coloca el MSI del agente en
  Resources\wazuh-agent.msi (o ejecuta build.ps1 una vez, que lo descarga).
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B7E1A2C4-9F3D-4E6A-8B21-000000000001}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WazuhAgentInstaller</RootNamespace>
    <AssemblyName>InstaladorAgente</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <OutputPath>dist\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\Program.cs" />
    <Compile Include="src\MainForm.cs" />
    <Compile Include="src\Branding.cs" />
    <Compile Include="src\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\wazuh-agent.msi">
      <LogicalName>wazuh-agent.msi</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\logo.png">
      <LogicalName>logo.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <!-- Respuesta activa (generados por build.ps1 a partir de active-response\src\*.py) -->
    <EmbeddedResource Include="Resources\active-response\ar-manifest.txt" Condition="Exists('Resources\active-response\ar-manifest.txt')">
      <LogicalName>ar-manifest.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\active-response\bin\netsh-block.exe" Condition="Exists('Resources\active-response\bin\netsh-block.exe')">
      <LogicalName>ar/netsh-block.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\active-response\bin\remove-threat.exe" Condition="Exists('Resources\active-response\bin\remove-threat.exe')">
      <LogicalName>ar/remove-threat.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
